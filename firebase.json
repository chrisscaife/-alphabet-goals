{
  "database": { "rules": "database.rules.json" },
  "hosting": {
    "public": "docs",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      { "source": "**/*.@(js|css|woff2|png|txt)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
      { "source": "sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "emulators": { "database": { "port": 9000 }, "auth": { "port": 9099 } }
}
